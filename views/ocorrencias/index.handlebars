<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/ocorrencias.css">

<div class="sio-dashboard-topbar">

    <a href="/dashboard" class="btn-voltar-dashboard">⬅</a>

    <div class="logo-dashboard-container">
        <img src="/css/sio2.png" class="logo-dash-img">
    </div>

    <div class="texto-boas-vindas-dash">
        Bem vindo ao SIO - Sistema Integrado de Ocorrências
    </div>

</div>

<div class="main-content">

    <div class="box-titulo">
        📋 CONTROLE DE OCORRÊNCIAS
    </div>

    <div class="box-corpo">

        <div class="filtros">

            <form action="/ocorrencias" method="GET" class="filtros">

                <input
                    type="text"
                    name="busca"
                    value="{{busca}}"
                    placeholder="Pesquisar aluno ou matrícula..."
                    class="input-sio-cinza"
                >

                <select name="turma" class="input-sio-cinza">

                    <option value="">Todas as Turmas</option>

                    <option value="1º Ano A">1º Ano A</option>
                    <option value="1º Ano B">1º Ano B</option>
                    <option value="2º Ano A">2º Ano A</option>
                    <option value="2º Ano B">2º Ano B</option>
                    <option value="3º Ano A">3º Ano A</option>
                    <option value="3º Ano B">3º Ano B</option>

                </select>

                <select name="tipo" class="input-sio-cinza">

                    <option value="">Todos os Tipos</option>

                    <option value="Bullying">Bullying</option>
                    <option value="Acidente">Acidente</option>
                    <option value="Mal-Estar">Mal-Estar</option>
                    <option value="Outros">Outros</option>

                </select>

                <button type="submit" class="btn-sio-enviar">
                    Buscar
                </button>

                <a href="/ocorrencias">
                    <button type="button" class="btn-sio-enviar">
                        Limpar
                    </button>
                </a>

                <a href="/ocorrencias/nova">
                    <button type="button" class="btn-sio-enviar">
                        Nova Ocorrência
                    </button>
                </a>

            </form>

        </div>

        <table class="sio-table">

            <thead>

                <tr>

                    <th>Aluno</th>
                    <th>Turma</th>
                    <th>Data</th>
                    <th>Tipo</th>
                    <th>Nível</th>
                    <th>Ações</th>

                </tr>

            </thead>

            <tbody>

                {{#each ocorrencias}}

                <tr>

                    <td>{{aluno}}</td>

                    <td>{{turma}}</td>

                    <td>{{data_ocorrencia}}</td>

                    <td>{{tipo_infracao}}</td>

                    <td>

                        <span class="circulo-cor {{nivel}}"></span>

                        {{nivel}}

                    </td>

                    <td>

                        <a href="/ocorrencias/ver/{{id}}">
                            <button type="button" class="btn-ver">
                                VER
                            </button>
                        </a>

                        <a href="/ocorrencias/editar/{{id}}">
                            <button type="button" class="btn-editar">
                                Editar
                            </button>
                        </a>

                        <form
                            action="/ocorrencias/excluir/{{id}}"
                            method="POST"
                            style="display:inline;"
                        >

                            <button
                                type="submit"
                                class="btn-excluir"
                                onclick="return confirm('Deseja excluir esta ocorrência?')"
                            >
                                Excluir
                            </button>

                        </form>

                    </td>

                </tr>

                {{else}}

                <tr>

                    <td colspan="6" style="text-align: center;">
                        Nenhuma ocorrência encontrada.
                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</div>